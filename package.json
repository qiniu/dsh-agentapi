{
  "name": "@qiniu/dsh-agentapi",
  "version": "0.1.1",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "description": "Qiniu AgentAPI integration for DeepSeek Harness.",
  "repository": { "type": "git", "url": "git+https://github.com/qiniu/dsh-agentapi.git" },
  "type": "module",
  "main": "./index.js",
  "exports": { ".": "./index.js", "./client": "./client.js", "./package.json": "./package.json" },
  "files": ["index.js", "client.js", "lib", "cordis.patch.yml", "README.md", "README.zh.md", "assets/*.png", "assets/*.jpg"],
  "scripts": { "test": "node --test" },
  "engines": { "node": ">=22.19" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-input-trigger", "@deepseek-ai/dsh-client-ui-primitives", "@deepseek-ai/dsh-client-ui-conversation"] }
  }
}
